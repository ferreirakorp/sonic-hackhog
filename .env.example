# Sonic the HackHog — Configuration
# Copy to .env and fill in your values

# Where visitors get redirected to
REDIRECT_URL=https://wise.com/

# API key for the monitor to pull visit logs (generate one: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEY=

# Cloudflare Tunnel token (for VPS deployment with docker-compose)
TUNNEL_TOKEN=

# Monitor settings (for monitor.py)
SERVER_URL=https://r.ferreirakorp.com
POLL_INTERVAL=3
